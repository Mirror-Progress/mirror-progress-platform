{
  "name": "@mirror-progress/identity-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Server-only, provider-neutral OIDC identity bridge for the Pages Router",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-dist/test/*.test.js",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": { "jose": "6.2.12" },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  }
}
