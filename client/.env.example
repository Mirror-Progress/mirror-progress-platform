# Declared in client/next.config.ts.
# Not currently used by the active frontend flows.
NEXT_PUBLIC_API_URL=

# MongoDB Atlas connection for the active Next.js app storage layer.
MONGODB_URI=
MONGODB_DB_NAME=mirror_progress

# Required for signed session cookies.
SESSION_SECRET=
AUTH_SESSION_SECRET=
NEXTAUTH_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public surface mode. Set both to "campaign" for the Vercel campaign site:
# public homepage/research/direct-link capability pages stay available while
# unfinished admin/workspace/internal APIs return hidden 404 responses.
SITE_SURFACE=
NEXT_PUBLIC_SITE_SURFACE=

# Public work/content bridge backed by Notion. These values are server-only
# except NEXT_PUBLIC_SITE_URL.
NOTION_API_KEY=
NOTION_WORK_DATABASE_ID=
NOTION_API_VERSION=2022-06-28
NOTION_MIRROR_PROGRESS_PAGE_ID=
NOTION_MIRROR_PROJECTS_DATABASE_ID=
NOTION_MIRROR_TASKS_DATABASE_ID=
NOTION_MIRROR_CONTENT_DATABASE_ID=
NOTION_MIRROR_WIKI_DATABASE_ID=
NOTION_MIRROR_COMPANY_MATERIALS_DATABASE_ID=
NOTION_MIRROR_CRM_PROFESSIONALS_DATABASE_ID=
NOTION_MIRROR_CRM_COMPANIES_DATABASE_ID=
NOTION_MIRROR_CRM_PERSONNEL_DATABASE_ID=
NOTION_MIRROR_LINKEDIN_CRM_DATABASE_ID=

# Read-only business development inventory sources. CRM-specific BD variables
# can override the general Mirror CRM variables above when needed.
NOTION_BD_ARCHITECTURE_REACHOUT_PAGE_ID=
NOTION_BD_ARCHITECTURE_FIRMS_DATABASE_ID=
NOTION_BD_COMPANIES_CRM_DATABASE_ID=
NOTION_BD_PROFESSIONALS_CRM_DATABASE_ID=
NOTION_BD_LINKEDIN_CRM_DATABASE_ID=

# SMTP email delivery for the contact form.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=

# Optional first-run bootstrap admin for protected deployments.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Mirror Progress Admin
BOOTSTRAP_ADMIN_COMPANY=Mirror Progress

# Demo/bootstrap data controls.
BOOTSTRAP_DEMO_DATA=true
ALLOW_DEV_SEED_ACCOUNTS=true

# Deployment protection and access behavior.
APP_PROTECTED_MODE=false
APP_ACCESS_PASSWORD=
ALLOW_PUBLIC_SIGNUP=true
ALLOW_PASSWORD_RESET=true

# Server-to-server secret for associating StudioIQ signups with canonical Mirror
# Progress accounts through /api/integrations/studioiq/account.
STUDIOIQ_INTEGRATION_SECRET=
