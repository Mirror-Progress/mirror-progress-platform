# Declared in client/next.config.ts.
# Not currently used by the active frontend flows.
NEXT_PUBLIC_API_URL=

# MongoDB Atlas connection for the active Next.js app storage layer.
MONGODB_URI=
MONGODB_DB_NAME=mirror_progress

# Required for signed session cookies.
SESSION_SECRET=
AUTH_SESSION_SECRET=

# Optional first-run bootstrap admin for protected deployments.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Mirror Progress Admin
BOOTSTRAP_ADMIN_COMPANY=Mirror Progress

# Demo/bootstrap data controls.
BOOTSTRAP_DEMO_DATA=true
ALLOW_DEV_SEED_ACCOUNTS=true

# Deployment protection and access behavior.
APP_PROTECTED_MODE=false
APP_ACCESS_PASSWORD=
ALLOW_PUBLIC_SIGNUP=true
ALLOW_PASSWORD_RESET=true
