# Operator processes ONLY. Copy to .env.operator; never pass this file to the service.
# These credentials are used by local PostgreSQL startup, migration, seed and integration tests.
MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE_OWNER_PASSWORD@localhost:5432/mirror_identity_synthetic
IDENTITY_RUNTIME_DB_PASSWORD=REPLACE_RUNTIME_PASSWORD
POSTGRES_PASSWORD=REPLACE_OWNER_PASSWORD
