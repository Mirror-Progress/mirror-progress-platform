# Runtime ONLY. Copy to .env and replace every placeholder.
# Do not put migration/admin credentials into this file or into the service container.
IDENTITY_MODE=synthetic
IDENTITY_ORIGIN=http://localhost:3040
IDENTITY_BIND_HOST=127.0.0.1
BETTER_AUTH_SECRET=REPLACE_WITH_48_PLUS_RANDOM_CHARACTERS
# Generate a hex password; use the same value in .env.operator's runtime-password setting.
DATABASE_URL=postgresql://mirror_identity_runtime:REPLACE_RUNTIME_PASSWORD@localhost:5432/mirror_identity_synthetic
